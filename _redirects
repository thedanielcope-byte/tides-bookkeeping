# Cloudflare Pages redirects
# Format: /from /to STATUS
#
# Order matters: first match wins.
# Specific rules MUST come before the apex catch-all at the bottom.
# (GHL / go.tidesbookkeeping.com is retired; everything lives on-site.)

# ─────────────────────────────────────────────
# Legacy URLs from previous platforms → current pages
# ─────────────────────────────────────────────
/home   /        301
/post   /blog    301

# ─────────────────────────────────────────────
# Old funnel paths → on-site pages (works on apex AND www)
# ─────────────────────────────────────────────
# Lead-magnet thank-you page: clean funnel URL → built file (Cloudflare ignores netlify.toml)
/tax-checklist/thanks            /tax-checklist-thanks.html                                      200

# Pricing now lives on-site at /pricing (pricing.html). Old GHL funnel URLs → local page.
/tiered-pricing                  /pricing                                                        301
/contact-info-for-pricing        /pricing                                                        301
/pricing-engagement-agreement    /pricing                                                        301

# Old GHL "7 Financial Tricks" funnel (go.tidesbookkeeping.com/7tricks) now lives on-site.
/7tricks                         /real-estate-agent-financial-mistakes                           301
/7tricks/*                       /real-estate-agent-financial-mistakes                           301
# Old GHL booking path (linked from older PDFs) → on-site booking page
/book-a-call                     /schedule                                                       301

# ─────────────────────────────────────────────
# Apex → www canonical redirect (catch-all)
# Note: if this doesn't fire reliably, set up a Cloudflare Dashboard
# Redirect Rule instead (Domain → Rules → Redirect Rules) — that
# operates at the edge before reaching Pages.
# ─────────────────────────────────────────────
https://tidesbookkeeping.com/*  https://www.tidesbookkeeping.com/:splat  301!
